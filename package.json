{
  "name": "@xyb-community/gtn-workbench",
  "version": "0.9.3",
  "description": "本机优先的GTN患者工作台：hCG血清序列时间线、化疗疗程折叠卡档案、末次妊娠与FIGO评分整理、治愈后随访日历与营养心理记录、临床研究登记摘录（0访谈如实声明，不做诊断与治疗建议）",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "schema",
    "research/gestational-trophoblastic/manifest.json",
    "research/gestational-trophoblastic/trials-2026.jsonl",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build:version": "node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:columns": "node --disable-warning=ExperimentalWarning scripts/check-demo-columns.mjs",
    "check:prototype": "node scripts/check-prototype.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check": "node scripts/build-version.mjs && node scripts/check-version.mjs && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node --disable-warning=ExperimentalWarning scripts/check-demo-columns.mjs && node scripts/build-client.mjs --check && node scripts/check-host-contract.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-trial-matching.mjs . && node scripts/check-workbench-package.mjs . && node scripts/check-prototype.mjs && node scripts/check-primer-links.mjs && node scripts/check-primer-links.mjs --data public/primer-data.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "pack:check": "npm pack --dry-run",
    "release:pack": "node scripts/build-client.mjs && node scripts/build-version.mjs && npm pack --pack-destination release",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "release:check": "npm run check && npm run test && npm run audit",
    "check:trial-matching": "node scripts/check-trial-matching.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/gtn-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
